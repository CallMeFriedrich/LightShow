# ── LightShow Konfiguration (Vorlage) ────────────────────────────────
# Kopieren nach `.env` und anpassen. Alle Werte haben sichere Defaults.

# ── Server ──────────────────────────────────────────────────────────
LIGHTSHOW_HOST=0.0.0.0
LIGHTSHOW_PORT=8000
LIGHTSHOW_LOG_LEVEL=INFO
LIGHTSHOW_DATA_DIR=./data

# ── Audio-Quelle ────────────────────────────────────────────────────
# source: sendspin | snapcast | pcm_tcp | synthetic
LIGHTSHOW_AUDIO_SOURCE=synthetic
LIGHTSHOW_AUDIO_SAMPLE_RATE=48000
LIGHTSHOW_AUDIO_CHANNELS=2
LIGHTSHOW_AUDIO_BLOCK_SIZE=1024

# Snapcast (wenn source=snapcast): Pfad zur snapclient-Binary + Server-Host
LIGHTSHOW_SNAPCLIENT_BIN=snapclient
LIGHTSHOW_SNAPCAST_HOST=127.0.0.1
LIGHTSHOW_SNAPCAST_PORT=1704

# PCM/TCP (wenn source=pcm_tcp)
LIGHTSHOW_PCM_TCP_HOST=127.0.0.1
LIGHTSHOW_PCM_TCP_PORT=4953

# SendSpin (wenn source=sendspin) — natives Music-Assistant-Protokoll
# mode: listen = wir werben per mDNS, MASS verbindet sich (Standard-Discovery)
#       connect = wir wählen den Server aktiv an
LIGHTSHOW_SENDSPIN_MODE=listen
LIGHTSHOW_SENDSPIN_NAME=LightShow
# nur bei mode=connect:
LIGHTSHOW_SENDSPIN_HOST=192.168.1.10
LIGHTSHOW_SENDSPIN_PORT=0

# ── Analyse ─────────────────────────────────────────────────────────
LIGHTSHOW_FFT_SIZE=2048
LIGHTSHOW_BANDS=16

# ── Output / Render ─────────────────────────────────────────────────
LIGHTSHOW_FRAME_RATE=40

# LED-Topologie: Canvas-Länge (LEDs pro Strip) + Anzahl paralleler Strips.
# Setup: 2 Strips à 480 LEDs.
LIGHTSHOW_LED_COUNT=480
LIGHTSHOW_FIXTURES=2

# ── WLED anbinden (bei Übergabe einfach die IPs hier eintragen) ──────
# Einfachster Weg: eine oder zwei WLED-IPs, mit Komma getrennt.
# Jeder Eintrag = ein Strip mit LIGHTSHOW_WLED_PIXELS LEDs. Leer = nur Preview.
# Beispiel:  LIGHTSHOW_WLED_HOSTS=10.10.1.50,10.10.1.51
LIGHTSHOW_WLED_HOSTS=
LIGHTSHOW_WLED_PIXELS=480

# Fortgeschritten (optional): volle JSON-Liste mit eigenen Namen/Pixelzahlen.
LIGHTSHOW_WLED_NODES=[]

# ── Music Assistant (Slice 2) ───────────────────────────────────────
# Hinweis: Bei source=sendspin kommen Titel/Cover/State bereits über SendSpin.
# Der separate MASS-WS-Client wird nur mit Token gestartet (MASS 2.9 verlangt Auth).
LIGHTSHOW_MASS_URL=
LIGHTSHOW_MASS_TOKEN=
# optional: bestimmten Player wählen (sonst automatisch der aktive)
LIGHTSHOW_MASS_PLAYER_ID=

# ── Home Assistant (Slice 3) ────────────────────────────────────────
LIGHTSHOW_HA_URL=
LIGHTSHOW_HA_TOKEN=
